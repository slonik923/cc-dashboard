                  "XDG_RUNTIME_DIR", "XDG_CURRENT_DESKTOP")


def desktop_env():
    """Environment with the graphical session's variables (a systemd service may start before them)."""
    env = dict(os.environ)
    if env.get("DISPLAY") or env.get("WAYLAND_DISPLAY"):
        return env
    try:
        out = subprocess.run(["systemctl", "--user", "show-environment"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return env
    for line in out.splitlines():
        k, _, v = line.partition("=")
        if k in GRAPHICAL_VARS and k not in env:
            env[k] = v
    return env


def notify(title, body, urgent=False):
    if os.environ.get("CC_SESSIONS_NOTIFY", "1") == "0" or not shutil.which("notify-send"):
        return
    cmd = ["notify-send", "-a", "Claude Code", "-i", "utilities-terminal"]
    if urgent:
        cmd += ["-u", "critical"]
    try:
        subprocess.Popen(cmd + [title, body], env=desktop_env(),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


TERMINALS = [  # (binary, args before the command)
    ("gnome-terminal", ["--"]),
    ("ptyxis", ["--new-window", "--"]),
    ("kgx", ["-e"]),
    ("konsole", ["-e"]),
    ("xfce4-terminal", ["-x"]),
    ("tilix", ["-e"]),
    ("kitty", []),
    ("alacritty", ["-e"]),
    ("x-terminal-emulator", ["-e"]),
    ("xterm", ["-e"]),
]


def terminal_command(cwd, argv):
    script = f"cd {shlex.quote(cwd)} && {shlex.join(argv)}; exec \"${{SHELL:-bash}}\""
    inner = ["bash", "-lc", script]
    custom = os.environ.get("CC_SESSIONS_TERMINAL")
    candidates = [(shlex.split(custom)[0], shlex.split(custom)[1:])] if custom else TERMINALS
    for binary, pre in candidates:
        if shutil.which(binary):
            return [binary] + pre + inner
    return None


def open_terminal(cwd, argv):
    """Open a new terminal window running argv in cwd; leaves a shell open afterwards."""
    cmd = terminal_command(cwd, argv)
    if not cmd:
        raise RuntimeError("No terminal emulator found; set CC_SESSIONS_TERMINAL")
    subprocess.Popen(cmd, cwd=cwd if os.path.isdir(cwd) else None, env=desktop_env(),
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return cmd[0]


def open_path(target):
    if shutil.which("xdg-open"):
        subprocess.Popen(["xdg-open", target], env=desktop_env(), stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


