def session_json(s):
    keep = ("id", "display_title", "title", "cwd", "branch", "first_ts", "last_ts", "prompts",
            "last_role", "pending_tool", "links", "files", "alive", "live_source",
            "mark", "pr_details", "state", "group", "label", "hook_message")
    d = {k: s.get(k) for k in keep}
    d["last_text"] = (s.get("last_text") or "")[-4000:]
    d["last_prompt"] = (s.get("last_prompt") or "")[-1500:]
    d["project"] = os.path.basename(s.get("cwd") or "") or "?"
    d["cwd_short"] = short_path(s.get("cwd"))
    return d


class Dashboard:
    def __init__(self, port):
        self.port = port
        self.token = self._token()
        self.lock = threading.Lock()
        self.snapshot = {"sessions": [], "generated": 0}
        self.etag = ""
        self.prev_states = None
        self.wake = threading.Event()

    @staticmethod
    def _token():
        try:
            tok = TOKEN_FILE.read_text().strip()
        except OSError:
            tok = ""
        if not tok:
            tok = secrets.token_urlsafe(24)
            TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
            TOKEN_FILE.write_text(tok)
            os.chmod(TOKEN_FILE, 0o600)
        return tok

    def refresh(self):
        rows = collect(include_all=True, days=10 ** 6)
        sessions = [session_json(s) for s in rows]
        counts = {g: 0 for g, _ in GROUPS}
        for s in sessions:
            counts[s["group"]] += 1
        snap = {
            "version": VERSION, "sessions": sessions, "counts": counts,
            "groups": [{"key": g, "label": l} for g, l in GROUPS],
            "states": {k: {"group": g, "label": l} for k, (g, l) in STATES.items()},
            "gh": bool(shutil.which("gh")), "hooks": hooks_installed(),
            "default_days": DEFAULT_DAYS,
        }
        etag = hashlib.sha1(json.dumps(snap, sort_keys=True).encode()).hexdigest()[:16]
        snap["generated"] = time.time()
        with self.lock:
            self.snapshot, self.etag = snap, etag
        self._notify_changes(rows)
        return rows

    def _notify_changes(self, rows):
        cur = {r["id"]: r["state"] for r in rows}
        prev, self.prev_states = self.prev_states, cur
        if prev is None:
            return  # first scan after start: don't replay everything
        for r in rows:
            st, before = r["state"], prev.get(r["id"])
            if st == before or st not in NOTIFY_STATES:
                continue
            if st == "idle" and before != "working":
                continue
            body = r.get("hook_message") or one_line(r.get("last_text"), 160)
            notify(f"{STATES[st][1]} · {title_of(r)[:60]}", body, urgent=r["group"] == "needs")

    def heartbeat(self):
        try:
            save_json(DAEMON_FILE, {"pid": os.getpid(), "port": self.port, "ts": time.time()})
        except OSError:
            pass

    def scan_loop(self):
        while True:
            self.wake.wait(2)
            self.wake.clear()
            try:
                self.refresh()
                self.heartbeat()
            except Exception as e:  # keep the daemon alive no matter what
                print(f"scan error: {e!r}", file=sys.stderr)

    def pr_loop(self):
        while True:
            try:
                with self.lock:
                    sessions = self.snapshot["sessions"]
                urls = []
                for s in sessions:
                    if s["group"] != "done" or time.time() - s["last_ts"] < 2 * 86400:
                        urls.extend(p["url"] for p in s["pr_details"])
                if urls and refresh_prs(list(dict.fromkeys(urls))):
                    self.wake.set()
            except Exception as e:
                print(f"pr error: {e!r}", file=sys.stderr)
            time.sleep(20)

    def find(self, sid):
        with self.lock:
            for s in self.snapshot["sessions"]:
                if s["id"] == sid:
                    return s
        return None

    def handle_action(self, body):
        sid, action = body.get("id"), body.get("action")
        s = self.find(sid) if isinstance(sid, str) else None
        if not s:
            return 404, {"error": "unknown session"}
        result = {"ok": True}
        if action in ("done", "undone", "park", "unpark", "note"):
            text = body.get("text")
            apply_action(sid, action, text if isinstance(text, str) else None)
        elif action == "resume":
            claude = shutil.which("claude") or "claude"
            try:
                result["terminal"] = open_terminal(s["cwd"] or str(HOME), [claude, "--resume", sid])
            except (RuntimeError, OSError) as e:
                return 500, {"error": str(e)}
            if s["mark"].get("done") or s["mark"].get("parked"):
                set_mark(sid, done=None, done_at=None, parked=None, parked_at=None)
        elif action == "open_folder":
            open_path(s["cwd"] or str(HOME))
        elif action == "refresh_prs":
            refresh_prs([p["url"] for p in s["pr_details"]], force=True)
        else:
            return 400, {"error": "unknown action"}
        self.refresh()
        return 200, result

    def make_handler(self):
        dash = self

        class Handler(BaseHTTPRequestHandler):
            server_version = "cc-sessions/" + VERSION

            def log_message(self, *a):
                pass

            def _host_ok(self):
                host = (self.headers.get("Host") or "").lower()
                return host in (f"127.0.0.1:{dash.port}", f"localhost:{dash.port}")

            def _send(self, code, body, ctype="application/json", extra=None):
                data = body if isinstance(body, bytes) else json.dumps(body).encode()
                self.send_response(code)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.send_header("Referrer-Policy", "no-referrer")
                for k, v in (extra or {}).items():
                    self.send_header(k, v)
                self.end_headers()
                self.wfile.write(data)

            def do_GET(self):
                if not self._host_ok():
                    return self._send(403, {"error": "bad host"})
                path = urlparse(self.path).path
                if path in ("/", "/index.html"):
                    try:
                        html = (WEB_DIR / "index.html").read_text(encoding="utf-8")
                    except OSError:
                        return self._send(500, {"error": "web/index.html missing"})
                    html = html.replace("__CC_TOKEN__", dash.token)
                    return self._send(200, html.encode(), "text/html; charset=utf-8", {
                        "Content-Security-Policy":
                            "default-src 'self'; script-src 'unsafe-inline'; "
                            "style-src 'unsafe-inline'; img-src 'self' data:; "
                            "connect-src 'self'; frame-ancestors 'none'"})
                if path == "/api/sessions":
                    if self.headers.get("X-CC-Token") != dash.token:
                        return self._send(403, {"error": "bad token"})
                    with dash.lock:
                        snap, etag = dash.snapshot, dash.etag
                    if self.headers.get("If-None-Match") == etag:
                        self.send_response(304)
                        self.send_header("ETag", etag)
                        self.end_headers()
                        return
                    return self._send(200, snap, extra={"ETag": etag})
                if path == "/api/health":
                    return self._send(200, {"ok": True, "version": VERSION})
                self._send(404, {"error": "not found"})

            def do_POST(self):
                if not self._host_ok() or self.headers.get("X-CC-Token") != dash.token:
                    return self._send(403, {"error": "forbidden"})
                if urlparse(self.path).path != "/api/action":
                    return self._send(404, {"error": "not found"})
                try:
                    n = min(int(self.headers.get("Content-Length") or 0), 65536)
                    body = json.loads(self.rfile.read(n) or b"{}")
                    if not isinstance(body, dict):
                        raise ValueError
                except ValueError:
                    return self._send(400, {"error": "bad json"})
                code, resp = dash.handle_action(body)
                self._send(code, resp)

        return Handler

    def serve(self):
        self.refresh()
        self.heartbeat()
        threading.Thread(target=self.scan_loop, daemon=True).start()
        threading.Thread(target=self.pr_loop, daemon=True).start()
        httpd = ThreadingHTTPServer(("127.0.0.1", self.port), self.make_handler())
        httpd.daemon_threads = True
        print(f"cc-sessions dashboard on http://localhost:{self.port}", flush=True)
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass
        finally:
            try:
                DAEMON_FILE.unlink()
            except OSError:
                pass


def daemon_running():
    d = load_json(DAEMON_FILE, {})
    return bool(d) and time.time() - (d.get("ts") or 0) < 30 and pid_alive(d.get("pid"), None)


