def format_rows(rows, width, numbered):
    out, current = [], None
    lw = max([len(r["label"]) for r in rows] + [10])
    for s in rows:
        if s["group"] != current:
            current = s["group"]
            out.append("\n" + c(dict(GROUPS)[current].upper(), ANSI[current]) + "\n")
        numbered.append(s["id"])
        proj = short_path(s["cwd"])
        proj = proj if len(proj) <= 28 else "…" + proj[-27:]
        live = c("●", "32") if s["alive"] else dim("○")
        left = (f"{len(numbered):>3} {live} {s['id'][:8]}  {ago(s['last_ts']):>4}  "
                f"{s['label']:<{lw}}  {proj:<28} ")
        badges = []
        for p in s["pr_details"]:
            st = p.get("state") or "?"
            badges.append(f"#{p['number']}:{'draft' if p.get('draft') and st == 'open' else st}")
        for kind, urls in s["links"].items():
            badges.append(f"{kind}×{len(urls)}")
        if s["files"]:
            badges.append(f"files×{len(s['files'])}")
        b = " ".join(badges)
        note = f"  [{s['mark']['note']}]" if s["mark"].get("note") else ""
        room = max(20, width - len(left) - len(b) - 2)
        out.append(left + bold(one_line(title_of(s) + note, room)) + ("  " + dim(b) if b else "") + "\n")
        if s["group"] == "needs":
            detail = s.get("hook_message") or (s["last_text"] if s["last_role"] == "assistant" else "")
            if detail:
                out.append(dim("        └ " + one_line(detail, width - 12)) + "\n")
    return "".join(out)


def cmd_list(args):
    rows = collect(args.all, args.days)
    width = shutil.get_terminal_size((120, 20)).columns
    numbered = []
    if not rows:
        print("No sessions. (Use -a to include done and older ones.)")
    else:
        sys.stdout.write(format_rows(rows, width, numbered))
    try:
        save_json(LAST_LIST_FILE, numbered)
    except OSError:
        pass
    if rows and not hooks_installed():
        print(dim("\nTip: `cc-sessions install` adds hooks (exact live states) and the dashboard."))
    elif daemon_running():
        print(dim(f"\nDashboard: http://localhost:{load_json(DAEMON_FILE, {}).get('port', DEFAULT_PORT)}"))


def resolve(ref):
    if ref.isdigit() and len(ref) < 4:
        listed = load_json(LAST_LIST_FILE, [])
        i = int(ref) - 1
        if 0 <= i < len(listed) and isinstance(listed[i], str):
            ref = listed[i]
    rows = collect(include_all=True, days=10 ** 6)
    hits = [r for r in rows if r["id"].startswith(ref)]
    if not hits:
        sys.exit(f"No session matches '{ref}'.")
    if len(hits) > 1:
        sys.exit(f"'{ref}' is ambiguous: " + ", ".join(h["id"][:12] for h in hits))
    return hits[0]


def cmd_show(args):
    s = resolve(args.id)
    if s["prs"] and not args.no_gh:
        refresh_prs(s["prs"], force=True)
        s["pr_details"] = [pr_info(u, pr_cache()) for u in s["prs"]]
    m = s["mark"]
    print(bold(title_of(s)))
    print(f"  id        {s['id']}")
    print(f"  state     {c(s['label'], ANSI[s['group']])}   {'running' if s['alive'] else 'not running'}")
    print(f"  folder    {short_path(s['cwd'])}" + (f"   branch {s['branch']}" if s["branch"] else ""))
    print(f"  started   {datetime.fromtimestamp(s['first_ts']):%Y-%m-%d %H:%M}   "
          f"last activity {ago(s['last_ts'])} ago   prompts {s['prompts']}")
    if m.get("note"):
        print(f"  note      {m['note']}")
    if s["pr_details"]:
        print(bold("\nPull requests"))
        for p in s["pr_details"]:
            if p.get("state"):
                bits = [p["state"] + (" (draft)" if p.get("draft") else ""), f"checks {p.get('checks')}"]
                if p.get("review"):
                    bits.append(p["review"].replace("_", " "))
                if p.get("mergeable") == "conflicting":
                    bits.append("conflicts")
                print(f"  {p['url']}  [{', '.join(bits)}]")
                if p.get("title"):
                    print(dim(f"    {p['title']}"))
            else:
                print(f"  {p['url']}" + (dim(f"  ({p['error']})") if p.get("error") else ""))
    if s["links"]:
        print(bold("\nLinks"))
        for kind, urls in s["links"].items():
            for u in urls:
                print(f"  {kind:<9}{u}")
    if s["files"]:
        print(bold("\nFiles written/edited"))
        for fp in s["files"][-15:]:
            print(f"  {short_path(fp)}")
        if len(s["files"]) > 15:
            print(dim(f"  … and {len(s['files']) - 15} more"))
    print(bold("\nYour last prompt"))
    print("  " + one_line(s.get("last_prompt"), 400))
    if s["last_role"] == "assistant":
        print(bold("\nClaude's last message"))
        for ln in s["last_text"].strip().splitlines()[-25:]:
            print("  " + ln)
    elif s.get("pending_tool"):
        print(bold(f"\nLast action: {s['pending_tool']} (no result yet)"))
    print(dim(f"\nresume:  cc-sessions resume {s['id'][:8]}"))


def cmd_mark(action):
    def run(args):
        s = resolve(args.id)
        text = " ".join(getattr(args, "text", None) or []) or None
        apply_action(s["id"], action, text)
        if action == "done" and text:
            apply_action(s["id"], "note", text)
        print(f"{action}: {s['id'][:8]}  {title_of(s)}")
    return run


def cmd_resume(args):
    s = resolve(args.id)
    claude = shutil.which("claude")
    if not claude:
        sys.exit("`claude` is not on PATH.")
    if s["cwd"] and os.path.isdir(s["cwd"]):
        os.chdir(s["cwd"])
    if s["mark"].get("done") or s["mark"].get("parked"):
        set_mark(s["id"], done=None, done_at=None, parked=None, parked_at=None)
    print(dim(f"cd {short_path(os.getcwd())} && claude --resume {s['id']}"))
    os.execv(claude, [claude, "--resume", s["id"]] + args.extra)


